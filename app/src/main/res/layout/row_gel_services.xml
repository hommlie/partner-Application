<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcv_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        app:cardElevation="@dimen/_1sdp"
        app:cardBackgroundColor="#262624"
        app:strokeWidth="0.5dp"
        app:cardCornerRadius="@dimen/_6sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/_15sdp"
            android:paddingBottom="@dimen/_15sdp"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp">

            <TextView
                android:id="@+id/tv_chemical_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Service Name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/tv_schedule"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintTop_toTopOf="parent"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_medium"
                />

            <TextView
                android:id="@+id/due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due:"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@id/tv_chemical_name"
                android:layout_marginTop="@dimen/_12sdp"
                android:textSize="@dimen/_10ssp"
                android:textColor="#C0BEB5"
                android:fontFamily="@font/inter_regular"
                />
            <TextView
                android:id="@+id/left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Days left:"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@id/due"
                android:layout_marginTop="@dimen/_2sdp"
                android:textSize="@dimen/_10ssp"
                android:textColor="#C0BEB5"
                android:fontFamily="@font/inter_regular"
                />
            <TextView
                android:id="@+id/tv_due_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Due date"
                app:layout_constraintStart_toEndOf="@id/due"
                app:layout_constraintEnd_toStartOf="@id/tv_schedule"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@id/tv_chemical_name"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:textSize="@dimen/_10ssp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_medium"
                />
            <TextView
                android:id="@+id/tv_days_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="1 day"
                app:layout_constraintStart_toEndOf="@id/left"
                android:singleLine="true"
                app:layout_constraintEnd_toStartOf="@id/tv_schedule"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintTop_toTopOf="@id/left"
                android:layout_marginStart="@dimen/_5sdp"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_medium"
                />

            <TextView
                android:id="@+id/tv_schedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_due_date"
                android:text="Schedule"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="@font/inter_medium"
                android:background="@drawable/bg_roundwhite5"
                android:backgroundTint="#253E5E"
                android:textColor="#7FA9DB"
                android:layout_marginTop="@dimen/_3sdp"
                android:paddingStart="@dimen/_13sdp"
                android:paddingEnd="@dimen/_13sdp"
                android:paddingTop="@dimen/_7sdp"
                android:paddingBottom="@dimen/_7sdp"
                />


            <LinearLayout
                android:id="@+id/ll_fulldetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tv_schedule"
                android:layout_marginTop="@dimen/_15sdp"
                android:visibility="gone">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_2sdp"
                    android:background="@drawable/dash_line"
                    />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mcv_dateslot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeColor="@color/gray_border"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:cardBackgroundColor="@color/white">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <LinearLayout
                            android:id="@+id/ll_allowed_window"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintTop_toTopOf="parent"
                            android:background="#253E5E">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Allowed service window"
                                android:layout_marginEnd="@dimen/_10sdp"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:textSize="@dimen/_11ssp"
                                android:singleLine="true"
                                android:textColor="#7FA9DB"
                                android:fontFamily="@font/inter_medium"
                                />
                            <TextView
                                android:id="@+id/tv_allowed_dates"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="June 03 - June 04, 2026"
                                android:singleLine="true"
                                android:layout_marginEnd="@dimen/_10sdp"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_marginBottom="@dimen/_10sdp"
                                android:textSize="@dimen/_10ssp"
                                android:textColor="@color/white"
                                />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/select_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_marginTop="@dimen/_12sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ll_allowed_window"
                            android:text="Select Date"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_11ssp"
                            android:fontFamily="@font/inter_bold"
                            />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            app:layout_constraintTop_toBottomOf="@id/select_date"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginBottom="@dimen/_6sdp"
                            android:layout_marginTop="@dimen/_14sdp"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mcv_timeslot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeColor="@color/gray_border"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:layout_constraintTop_toBottomOf="@id/mcv_dateslot"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:cardBackgroundColor="@color/white">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >
                        <TextView
                            android:id="@+id/select_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_marginTop="@dimen/_12sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:text="Select Time Slot"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_11ssp"
                            android:fontFamily="@font/inter_bold"
                            />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:layout_marginEnd="@dimen/_6sdp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginBottom="@dimen/_6sdp"
                            app:layout_constraintTop_toBottomOf="@id/select_time"
                            android:layout_marginTop="@dimen/_6sdp"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>



            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>