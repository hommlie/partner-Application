<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        app:cardElevation="0dp"
        android:elevation="0dp"
        app:strokeColor="@color/color_e6e6e6"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_2sdp"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcv_sno"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_25sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_12sdp"
                app:strokeWidth="0dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="@dimen/_20sdp"
                app:cardBackgroundColor="@color/color_d6ebe0"
                >
                <TextView
                    android:id="@+id/tv_sno"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="1"
                    android:textSize="@dimen/_12ssp"
                    android:maxLength="2"
                    android:singleLine="true"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:fontFamily="@font/inter_medium"
                    android:paddingTop="@dimen/_1sdp"
                    android:textColor="@color/color_primary_dark"
                    />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_chemical_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/mcv_sno"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/mcv_sno"
                app:layout_constraintBottom_toBottomOf="@id/mcv_sno"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:text="Chemical Name"
                android:textColor="@color/black"
                android:fontFamily="@font/inter_medium"
                android:textSize="@dimen/_12ssp"
                android:maxLines="2"/>

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="mcv_sno,tv_chemical_name"
                />

            <View
                android:id="@+id/v1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                app:layout_constraintTop_toBottomOf="@id/barrier"
                android:background="@color/color_e6e6e6"
                android:layout_marginTop="@dimen/_6sdp"
                />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5"/>

            <TextView
                android:id="@+id/available"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@id/frame_edt_qty"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/_12sdp"
                android:text="Available"
                android:textColor="@color/color_596a5c"
                android:textSize="@dimen/_11ssp"/>
            <TextView
                android:id="@+id/tv_available_qty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/frame_edt_qty"
                app:layout_constraintStart_toStartOf="@id/available"
                app:layout_constraintEnd_toEndOf="@id/available"
                android:textAlignment="textEnd"
                android:singleLine="true"
                android:fontFamily="@font/plusjakartasans_semi_bold"
                android:textColor="@color/black"
                android:textSize="@dimen/_13ssp"
                android:text="590"/>

            <TextView
                android:id="@+id/tv_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@id/frame_edt_qty"
                app:layout_constraintBottom_toBottomOf="@id/frame_edt_qty"
                app:layout_constraintStart_toEndOf="@id/available"
                app:layout_constraintEnd_toStartOf="@id/guideline"
                android:text="ml"
                android:textColor="@color/color_596a5c"
                android:fontFamily="@font/inter_medium"
                android:textSize="@dimen/_12ssp"/>

            <FrameLayout
                android:id="@+id/frame_edt_qty"
                android:layout_width="0dp"
                android:layout_height="@dimen/_33sdp"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="@id/guideline"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@id/v1"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/_12sdp">

                <!-- Editable numeric field -->
                <EditText
                    android:id="@+id/etUsedQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_quantity_field"
                    android:gravity="end|center_vertical"
                    android:paddingStart="@dimen/_13sdp"
                    android:paddingEnd="@dimen/_13sdp"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:textColor="@color/text_value_dark"
                    android:textColorHint="@color/text_unit_grey"
                    android:hint="-"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:imeOptions="actionDone"
                    android:cursorVisible="true" />

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>